  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "sequence": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Sequence"
          },
          "expected_epoch": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Epoch"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "expected_epoch",
          "kind"
        ],
        "title": "Command"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewSession": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id",
            "default": "synthetic-audio-reference"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "default": "audio_reference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewSession"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
