  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Revision"
          },
          "accept_static_reference_limitations": {
            "type": "boolean",
            "const": true,
            "title": "Accept Static Reference Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "accept_static_reference_limitations"
        ],
        "title": "ApprovalInput"
      },
      "Command": {
        "properties": {
          "sequence": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Sequence"
          },
          "expected_epoch": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Epoch"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1500
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "expected_epoch",
          "kind"
        ],
        "title": "Command"
      },
      "ConsentInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "synthetic_fixture",
              "human_consented",
              "research_authorized"
            ],
            "title": "Kind"
          },
          "reference": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reference"
          },
          "allowed_uses": {
            "items": {
              "type": "string",
              "enum": [
                "timing_fixture_only",
                "research_avatar"
              ]
            },
            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Allowed Uses"
          },
          "attested": {
            "type": "boolean",
            "const": true,
            "title": "Attested"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "reference",
          "allowed_uses",
          "attested"
        ],
        "title": "ConsentInput"
      },
      "EnrollmentInput": {
        "properties": {
          "upload_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Upload Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "upload_id",
          "name"
        ],
        "title": "EnrollmentInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewSession": {
        "properties": {
          "asset_id": {
            "type": "string",
            "title": "Asset Id",
            "default": "synthetic-audio-reference"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "default": "audio_reference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NewSession"
      },
      "UploadInput": {
        "properties": {
          "purpose": {
            "type": "string",
            "const": "avatar_import",
            "title": "Purpose",
            "default": "avatar_import"
          },
          "content_type": {
